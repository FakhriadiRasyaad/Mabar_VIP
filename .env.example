# ============================================================
# Supabase
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================
# Duitku Payment Gateway
# ============================================================
# Get credentials from https://sandbox.duitku.com (sandbox)
# or https://passport.duitku.com (production)
DUITKU_MERCHANT_CODE=DXXXX
DUITKU_API_KEY=your-duitku-api-key
DUITKU_IS_SANDBOX=true
# Full URL where Duitku sends payment callbacks (must be publicly accessible)
DUITKU_CALLBACK_URL=https://your-domain.com/api/payments/duitku/callback
# URL where guest is redirected after payment
DUITKU_RETURN_URL=https://your-domain.com/checkout

# ============================================================
# Application
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Default order expiry in minutes
ORDER_EXPIRY_MINUTES=60
